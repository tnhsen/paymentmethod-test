{
  "name": "payment-qr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm typecheck && vitest run && playwright test",
    "test:unit": "vitest run",
    "dev": "tsx packages/server/src/main.ts",
    "start": "pnpm build:demo && node --env-file=.env scripts/dev.mjs",
    "build:demo": "pnpm --filter @payment-qr/core build && pnpm --filter @payment-qr/sdk-js build && pnpm --filter @payment-qr/web-component build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
